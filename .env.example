# Ambiente da aplicacao
APP_ENV=development

# PostgreSQL - ambiente local
# Defina a mesma senha em POSTGRES_PASSWORD e DATABASE_URL
POSTGRES_PASSWORD=troque_esta_senha_local

# Conexao do Python com o PostgreSQL no Docker
DATABASE_URL=postgresql+psycopg://agrotracer:troque_esta_senha_local@127.0.0.1:55432/agrotracer

# Integracao com WordPress
WORDPRESS_URL=https://example.invalid

# Seguranca da integracao
BRIDGE_AUTH_MODE=pendente_de_definicao

# Redis - protecao anti-replay da Bridge
AGROTRACER_REDIS_URL=redis://127.0.0.1:16379/0

# Segredo HMAC - configurar somente no .env local
AGROTRACER_BRIDGE_SECRET=
